APP_NAME=citrus-api
ENV=development
DEBUG=true

# Mongo (local compose service hostname is `mongo`)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=citrus

# Google SSO — OAuth 2.0 client IDs (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=123456789-web.apps.googleusercontent.com,123456789-ios.apps.googleusercontent.com,123456789-android.apps.googleusercontent.com

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

AUTH_DISABLED=false
DEV_AUTH_UID=
DEV_AUTH_EMAIL=
DEV_AUTH_NAME=

CORS_ORIGINS=http://localhost:3000,http://localhost:19006,https://citrus.joed.dev,https://citrusnative.joed.dev
