# Copy to /opt/services/data/app-env/citrus-api.env on glados (never commit secrets).

APP_NAME=citrus-api
ENV=production
DEBUG=false

MONGODB_URI=mongodb://citrus-mongo:27017
MONGODB_DB=citrus

GOOGLE_CLIENT_IDS=REPLACE_WEB_CLIENT_ID,REPLACE_IOS_CLIENT_ID,REPLACE_ANDROID_CLIENT_ID
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

AUTH_DISABLED=false

CORS_ORIGINS=https://citrus.joed.dev,https://citrusnative.joed.dev
