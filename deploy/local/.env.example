# Local full-stack defaults (copy to deploy/local/.env)

JWT_SECRET=local-dev-secret-change-me-32chars!!
GOOGLE_CLIENT_IDS=
AUTH_DISABLED=true
DEV_AUTH_UID=local-dev-user
DEV_AUTH_EMAIL=dev@citrus.local
DEV_AUTH_NAME=Local Dev

# Browser-reachable API URL baked into UI images
REACT_APP_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:3000,http://localhost:19006
